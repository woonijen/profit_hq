# Copy to .env and fill in. Never commit the real .env file.

NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# Origin of the frontend (used for CORS). Vite dev server default:
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Atlas connection string (include the database name, e.g. /profithq)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/profithq?retryWrites=true&w=majority

# Generate each with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# The two secrets must be different. Minimum 32 characters.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Access token lifetime (e.g. 15m) and refresh token lifetime in days
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
