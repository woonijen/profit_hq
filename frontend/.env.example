# Copy to .env. Only variables prefixed with VITE_ are exposed to the browser.

# Base URL of the API. Keep "/api" in development (Vite proxies it to the backend).
# In production set the full backend URL, e.g. https://api.example.com/api
VITE_API_BASE_URL=/api

# Dev-only: where the Vite dev server proxies /api to (not exposed to the browser).
DEV_API_PROXY_TARGET=http://localhost:4000
